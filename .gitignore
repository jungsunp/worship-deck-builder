# ---- Church data: NEVER commit (offering amounts, member names, private messages) ----
data/
!src/worship_deck/bible/data/
!src/worship_deck/bible/data/**
*.key
*.numbers
*.pages

# Weekly source material that may contain member data
*.pdf
*.jpg
*.jpeg
*.png
*.heic
*.mp4
*.mov
# (allow design assets that are intentionally tracked: see git add -f, or whitelist below)
!src/worship_deck/render/templates/**/*.png
# Style-reference doc images (#167): public church live-stream stills + non-sensitive
# deck slides (psalm/creed/divider/lyric — no member names or offering amounts).
!docs/style-references/**/*.png
!docs/style-references/**/*.jpg

# ---- Secrets ----
.env
.env.*
!.env.example
*.key.json
credentials*.json

# ---- Logs ----
logs/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- macOS / editor ----
.DS_Store
.vscode/
.idea/

# ---- Claude Code: ignore local/runtime state, keep shared skills tracked ----
.claude/scheduled_tasks.lock
.claude/settings.local.json

# ---- Allow synthetic test fixtures (anonymized only — never real church data) ----
!tests/fixtures/
!tests/fixtures/**
