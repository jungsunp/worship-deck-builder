# Copy to .env and fill in. .env is git-ignored.

# Lyric transcription — free local hybrid (Apple Vision OCR + a local Ollama model).
# No API key. Requires Xcode Command Line Tools (`swift`) and a running Ollama:
#   brew install ollama && ollama serve && ollama pull qwen3.5:27b
# qwen3.5:27b (17GB) gave the best recall/quality on real medley sheets; exaone3.5:7.8b
# (4.8GB) is a strong lighter alternative. The reassembly stage is model-agnostic.
OLLAMA_MODEL=qwen3.5:27b
OLLAMA_HOST=http://127.0.0.1:11434

# ESV API — free, non-commercial. Get a key at https://api.esv.org/
ESV_API_KEY=

# Paths (defaults assume iCloud Drive). Override as needed.
INBOX_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/WorshipDeck/inbox
TEMPLATE_KEY=~/Projects/worship-deck-builder/templates/master.key

# Web app
WEB_HOST=127.0.0.1
WEB_PORT=8787

# Notifications — set a hard-to-guess topic, subscribe to it in the ntfy phone app.
# Leave blank to disable. https://ntfy.sh/
NTFY_TOPIC=

